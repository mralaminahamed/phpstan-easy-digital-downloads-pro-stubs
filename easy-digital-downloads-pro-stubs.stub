namespace EDD\Pro\CartRecovery\Events {
    /**
     * Cart Event Subscriber class.
     *
     * Subscribes to WordPress events related to cart changes and persists snapshots.
     */
    class CartEventSubscriber implements \EDD\EventManagement\SubscriberInterface
    {
        use \EDD\Pro\CartRecovery\Traits\Debug;
        /**
         * Snapshot persistence instance.
         *
         * @var SnapshotPersistence
         */
        private \EDD\Pro\CartRecovery\Snapshots\SnapshotPersistence $snapshot_persistence;
        /**
         * Event logger instance.
         *
         * @var EventLogger
         */
        private \EDD\Pro\CartRecovery\Journey\EventLogger $event_logger;
        /**
         * Constructor.
         *
         * @since 3.6.5
         * @param SnapshotPersistence $snapshot_persistence Snapshot persistence instance.
         * @param EventLogger|null    $event_logger         Event logger instance.
         */
        public function __construct(\EDD\Pro\CartRecovery\Snapshots\SnapshotPersistence $snapshot_persistence, ?\EDD\Pro\CartRecovery\Journey\EventLogger $event_logger = null)
        {
        }
        /**
         * Returns subscribed events.
         *
         * @since 3.6.5
         * @return array Event subscriptions.
         */
        public static function get_subscribed_events(): array
        {
        }
        /**
         * Handles cart mutations by persisting a fresh snapshot.
         *
         * @since 3.6.5
         * @return void
         */
        public function on_cart_changed(): void
        {
        }
        /**
         * Handles explicit cart empty events.
         *
         * When a cart is emptied, this deletes the stored recovery cart.
         * Skips deletion during purchase completion - the CheckoutEventSubscriber
         * handles marking carts as recovered in that case.
         *
         * @since 3.6.5
         * @return void
         */
        public function on_cart_emptied(): void
        {
        }
    }
