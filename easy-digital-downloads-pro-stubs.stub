         * @since 3.6.6
         * @var string
         */
        const TYPE_TEXT = 'text';
        /**
         * Currency value type.
         *
         * @since 3.6.6
         * @var string
         */
        const TYPE_CURRENCY = 'currency';
        /**
         * Number value type.
         *
         * @since 3.6.6
         * @var string
         */
        const TYPE_NUMBER = 'number';
