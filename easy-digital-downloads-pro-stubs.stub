         *
         * @return void
         */
        private function mark_complete($add_notification = true)
        {
        }
        /**
         * Gets the initial notification about the migration.
         *
         * @since 3.2.0
         *
         * @return object
         */
        private function get_initial_notification()
        {
        }
        /**
