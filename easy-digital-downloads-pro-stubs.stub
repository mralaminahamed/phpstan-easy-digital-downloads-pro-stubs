         * @param int $order_id Order ID.
         * @return void
         */
        private function recover_cart_from_session(int $order_id): void
        {
        }
        /**
         * Marks the specific recovery email that led to conversion.
         *
         * When a purchase is completed, we mark only the recovery email that was clicked
         * as "converted" and set date_used so the token is no longer valid.
         *
         * If no email ID is provided (direct purchase without clicking email), no emails are marked.
         *
         * @since 3.6.5
         * @param int      $cart_id  Cart ID.
         * @param int|null $email_id Email ID that led to conversion, or null.
         * @return void
         */
