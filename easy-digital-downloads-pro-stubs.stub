namespace EDD\EventManagement {
    // @codeCoverageIgnore
    /**
     * Class MiniManager
     *
     * @since 3.3.9
     */
    abstract class MiniManager implements \EDD\EventManagement\SubscriberInterface
    {
        /**
         * The hook to subscribe to.
         *
         * @since 3.3.9
         * @var string
         */
        protected static $hook = 'plugins_loaded';
        /**
         * The priority to subscribe to.
         *
         * @since 3.6.5
         * @var int
         */
        protected static $priority = 10;
        /**
         * Track which classes have already added their events.
         *
         * @since 3.5.0
         * @var array
         */
        private static $events_added = array();
        /**
         * Get the events to subscribe to.
         *
         * @since 3.3.9
         * @return array
         */
        public static function get_subscribed_events()
        {
        }
        /**
         * Add the events.
         *
         * @since 3.3.9
         * @return void
         */
        public function add_events()
        {
        }
        /**
         * Get the event classes.
         *
         * @since 3.3.9
         * @return array
         */
        abstract protected function get_event_classes(): array;
    }
}
