    /**
     * Class LogicalExpression
     *
     * @since 3.6.6
     */
    class LogicalExpression
    {
        /**
         * Regex pattern for a single condition token.
         *
         * Captures three groups:
         *   1. The condition key (alphanumeric, underscores, hyphens).
         *   2. The operator (>=, <=, !=, >, <, or =).
         *   3. The quoted value (content between double quotes).
         *
         * The operator is always placed between the key and the opening quote.
         * HTML entities for < and > (&lt; &gt; &amp;) are decoded before matching.
         *
         * @since 3.6.6
         * @var string
         */
        const CONDITION_PATTERN = '/^([a-zA-Z0-9_\-]+)\s*(>=|<=|!=|>|<|=)\s*"([^"]*)"$/';
        /**
         * Parse a logical expression string into structured conditions and operators.
         *
         * Returns an array alternating between condition arrays and logical operators:
         *   [ [key, operator, value], 'AND', [key], 'OR', ... ]
         *
         * Conditions are represented as either:
         *   - Triplet arrays: [ 'key', 'operator', 'value' ].
         *   - Singleton arrays: [ 'key' ] for boolean conditions.
         *
         * Supports:
         *   - Explicit AND/OR between conditions.
         *   - Implicit AND when conditions are space-separated without a logical operator.
         *
         * @since 3.6.6
         *
         * @param string $expression The raw expression string from inside {if ...}.
         * @return array Parsed array of conditions and logical operators.
         */
        public static function parse_expression($expression)
        {
        }
        /**
         * Tokenize a segment string into individual conditions.
         *
         * Matches:
         *   - Comparison conditions (triplets): key="value", key!="value", key>="value", etc.
         *   - Boolean conditions (singletons): key
         *
         * Comparison matches are evaluated before boolean matches so strings like
         * key="value" are captured as a single triplet, not as a standalone key.
         *
         * @since 3.6.6
         *
         * @param string $segment A segment of the expression (between AND/OR operators).
         * @return array Array of condition arrays [ [key, operator, value], [key], ... ].
         */
        private static function tokenize_conditions($segment)
        {
        }
        /**
         * Evaluate a parsed logical expression using the condition registry.
         *
         * Walks through the parsed array from parse_expression(), evaluates each
         * condition triplet by looking up the condition in the registry and calling
         * its evaluate() method with the operator and value. Results are combined
         * using AND/OR logic, evaluated left-to-right (no operator precedence).
         *
         * @since 3.6.6
         *
         * @param array             $parsed     Parsed array from parse_expression().
         * @param ConditionRegistry $registry   The condition registry instance.
         * @param int               $object_id  The EDD object ID (e.g. order ID).
         * @param object            $edd_object The EDD object (e.g. Order).
