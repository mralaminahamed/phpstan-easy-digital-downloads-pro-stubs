namespace EDD\Pro\CartRecovery\Admin\Reports\Endpoints\Tiles\Traits {
    /**
     * Trait for sharing cart statistics queries across multiple tiles.
     *
     * Uses a static cache to ensure the database query only runs once
     * even when multiple tiles request the same data.
     *
     * @since 3.6.5
     */
    trait Carts
    {
        /**
         * Cached cart statistics keyed by date range.
         *
         * @var array
         */
        private static $cart_stats_cache = array();
        /**
         * Gets cart statistics for the current date range.
         *
         * Results are cached statically so multiple tiles can access
         * the same data without running redundant queries.
         *
         * @since 3.6.5
         * @return array {
         *     Cart statistics.
         *
         *     @type int   $total_carts     Total carts tracked.
         *     @type int   $abandoned_count Carts with abandoned status.
         *     @type int   $recovered_count Carts with recovered status.
         *     @type float $total_value     Total cart value.
         *     @type float $recovered_value Value of recovered carts.
         *     @type float $recovery_rate   Recovery rate percentage.
         * }
         */
        protected function get_cart_stats(): array
        {
        }
        /**
         * Returns default cart statistics structure.
         *
         * @since 3.6.5
         * @return array
         */
        private function get_default_cart_stats(): array
        {
        }
    }
}
