         */
        protected function get_callback()
        {
        }
        /**
         * Gets the screen.
         *
         * @since 3.3.6
         * @return array
         */
        protected function get_screen()
        {
        }
        /**
         * Gets the additional arguments for the callback.
         *
         * @since 3.3.6
         * @return array
         */
        protected function get_callback_args(): array
        {
        }
        /**
         * Sort the sections by priority.
