namespace EDD\Pro\Emails\ConditionalTags {
    /**
     * Class ConditionRegistry
     *
     * @since 3.6.6
     */
    class ConditionRegistry
    {
        /**
         * Registered conditions grouped by key.
         *
         * @since 3.6.6
         * @var array<string, ConditionInterface[]>
         */
        protected $conditions = array();
        /**
         * Register a new condition.
         *
         * Multiple conditions may share the same key provided they serve
         * different contexts. Duplicate context registrations are silently
         * ignored so the first condition to register for a context wins.
         *
         * @since 3.6.6
         *
         * @param ConditionInterface $condition Condition object to register.
         * @return void
         */
        public function register(\EDD\Pro\Emails\ConditionalTags\Conditions\ConditionInterface $condition)
        {
        }
        /**
         * Get a condition by key, optionally resolved by context.
         *
         * Resolution order when a context is provided:
         *   1. Exact context match (condition whose contexts include the given context).
         *   2. Universal fallback (condition with empty contexts array).
         *
         * When called without a context the first registered condition is returned
         * for backward compatibility.
         *
         * @since 3.6.6
         *
         * @param string $key     Condition key.
         * @param string $context Optional email context for resolution.
         * @return ConditionInterface|null Condition object or null if not found.
         */
        public function get($key, $context = '')
        {
        }
        /**
         * Check whether any condition is registered for a key.
         *
         * @since 3.6.6
         *
         * @param string $key     Condition key.
         * @param string $context Optional email context to check.
         * @return bool
         */
        public function has($key, $context = '')
        {
        }
        /**
         * Get all registered conditions as a flat array.
         *
         * @since 3.6.6
         *
         * @return ConditionInterface[] Array of condition objects.
         */
        public function all()
        {
        }
        /**
         * Get all registered first-class conditions.
         *
         * Excludes TagProxy instances that mirror email tags.
         *
         * @since 3.6.6
         *
         * @return ConditionInterface[] Array of first-class condition objects.
         */
        public function get_first_class_conditions()
        {
        }
        /**
         * Get first-class condition metadata for UI consumers.
         *
         * When multiple conditions share the same key (e.g. core's Download for
         * 'order' and recurring's Download for 'subscription'), their operators
         * and contexts are merged into a single metadata entry so the UI sees one
         * unified option. The seed condition — which provides the label and
         * inputType — is resolved via get() so the context-appropriate condition
         * wins.
         *
         * @since 3.6.6
         *
         * @param string $context Optional email context for seed resolution.
         * @return array<string, array> First-class metadata keyed by condition key.
         */
        public function get_first_class_condition_metadata($context = '')
        {
        }
        /**
         * Check whether an existing condition conflicts with the given contexts.
         *
         * A conflict exists when an already-registered condition for the same key
         * covers the same context(s) as the incoming one, meaning the new condition
         * would be a duplicate and should not be registered.
         *
         * @since 3.6.6
         *
         * @param string   $key          Condition key.
         * @param string[] $new_contexts Contexts the incoming condition supports.
         * @return bool True if a conflict is found and registration should be skipped.
         */
        private function has_conflicting_condition($key, array $new_contexts)
        {
        }
    }
}
namespace EDD\Pro\Emails\ConditionalTags\Conditions {
    // @codeCoverageIgnore
    /**
     * Interface ConditionInterface
     *
     * @since 3.6.6
     */
    interface ConditionInterface
    {
        /**
         * Get the unique key for this condition.
         *
         * This key is used to match the condition name in the expression
         * (e.g. 'gateway' in {if gateway="stripe"}).
         *
         * @since 3.6.6
         *
         * @return string Condition key.
         */
        public function get_key();
        /**
         * Get the human-readable label for this condition.
         *
         * @since 3.6.6
         *
         * @return string Condition label.
         */
        public function get_label();
        /**
         * Get the comparison operators supported by this condition.
         *
         * @since 3.6.6
         *
         * @return string[] Supported operators.
         */
        public function get_supported_operators();
        /**
         * Get the email contexts supported by this condition.
         *
         * Return an empty array when the condition is allowed in all contexts.
         *
         * @since 3.6.6
         *
         * @return string[] Supported contexts.
         */
        public function get_supported_contexts();
        /**
         * Get the UI input type descriptor for the value field.
         *
         * Returns an array with at minimum a 'type' key. Supported types:
         * 'text', 'date', 'select', 'number', 'hidden'.
         *
         * The 'select' type must also include an 'options' key containing
         * an array of value/label pairs.
         *
         * @since 3.6.6
         *
         * @return array{type: string, options?: array} UI input type descriptor.
         */
        public function get_ui_input_type();
        /**
         * Evaluate the condition for a given order, operator, value, and context.
         *
         * The operator parameter indicates how the comparison should be performed:
         *   - '='  : The actual value equals the expected value.
         *   - '!=' : The actual value does not equal the expected value.
         *   - '>'  : The actual value is greater than the expected value.
         *   - '>=' : The actual value is greater than or equal to the expected value.
         *   - '<'  : The actual value is less than the expected value.
         *   - '<=' : The actual value is less than or equal to the expected value.
         *
         * Conditions that only support equality/inequality (e.g. string conditions
         * like gateway or username) should return false for ordering operators.
         *
         * @since 3.6.6
         *
         * @param int    $object_id  The EDD object ID (e.g. order ID).
         * @param object $edd_object The EDD object (e.g. Order instance).
         * @param object $email      The EDD email object.
         * @param mixed  $value      The expected value to compare against.
         * @param string $operator   The comparison operator (=, !=, >, >=, <, <=).
         * @param mixed  $context    Additional contextual data for evaluation.
         * @return bool True if the condition passes, false otherwise.
         */
        public function evaluate($object_id, $edd_object, $email, $value, $operator = '=', $context = '');
    }
}
namespace EDD\Pro\Emails\ConditionalTags\Conditions\Traits {
    /**
     * Trait ContextAware
     *
     * @since 3.6.6
     */
    trait ContextAware
    {
        /**
         * Check whether this condition can run in the given context.
         *
         * Returns true if:
         *   - The condition has no context restrictions (empty supported contexts).
         *   - The current context is empty (no filtering).
         *   - The current context is in the supported contexts list.
         *
         * @since 3.6.6
         *
         * @param mixed $context Email context.
         * @return bool
         */
        protected function is_context_allowed($context)
        {
        }
    }
}
namespace EDD\Pro\Emails\ConditionalTags\Conditions {
    /**
     * Class AbstractCondition
     *
     * @since 3.6.6
     */
    abstract class AbstractCondition implements \EDD\Pro\Emails\ConditionalTags\Conditions\ConditionInterface
    {
        use \EDD\Pro\Emails\ConditionalTags\Conditions\Traits\ContextAware;
        /**
         * Supported operators for this condition.
         *
         * Child conditions can override this property as needed.
         *
         * @since 3.6.6
         * @var string[]
         */
        protected $supported_operators = array();
        /**
         * Supported email contexts for this condition.
         *
         * Empty means all contexts are allowed.
         *
         * @since 3.6.6
         * @var string[]
         */
        protected $supported_contexts = array();
        /**
         * UI input type descriptor for the value field.
         *
         * Child conditions can override this property to render a different
         * input widget (e.g. 'date', 'select', 'number', 'hidden').
         *
         * @since 3.6.6
         * @var array
         */
        protected $ui_input_type = array('type' => 'text');
        /**
         * Get the comparison operators supported by this condition.
         *
         * @since 3.6.6
         *
         * @return string[]
         */
        public function get_supported_operators()
        {
        }
        /**
         * Get the email contexts supported by this condition.
         *
         * @since 3.6.6
         *
         * @return string[]
         */
        public function get_supported_contexts()
        {
        }
        /**
         * Get the UI input type descriptor for the value field.
         *
         * @since 3.6.6
         *
         * @return array{type: string, options?: array}
         */
        public function get_ui_input_type()
        {
        }
        /**
         * Get custom operator labels for the UI.
         *
         * Override in child classes to replace the default operator labels
         * (e.g. "is" / "is not") with condition-specific labels like
         * "contains" / "does not contain" for multi-select conditions.
         *
         * @since 3.6.6
         *
         * @return array<string, string> Operator symbol to label map, or empty for defaults.
         */
        public function get_operator_labels()
        {
        }
    }
}
