namespace EDD\Pro\CartRecovery\CLI {
    /**
     * Cart Recovery WP-CLI commands.
     *
     * @since 3.6.5
     */
    class CartRecovery implements \EDD\EventManagement\SubscriberInterface
    {
        use \EDD\CLI\Traits\TestData;
        /**
         * Returns an array of events that this subscriber wants to listen to.
         *
         * @since 3.6.5
         * @return array
         */
        public static function get_subscribed_events()
        {
        }
