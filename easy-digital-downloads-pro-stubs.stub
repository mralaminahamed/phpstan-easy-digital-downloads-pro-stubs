namespace EDD\REST\Routes {
    /**
     * Route class
     *
     * Abstract class for REST routes.
     *
     * @since 3.6.2
     */
    abstract class Route
    {
        const NAMESPACE = 'edd';
        /**
         * Version number.
         *
         * @since 3.6.2
         * @var string
         */
        public static $version = 'v3';
        /**
         * Controller instance.
         *
         * @since 3.6.5
         * @var Controller
         */
        protected $controller;
        /**
         * Security instance.
         *
         * @since 3.6.5
         * @var Security
         */
        protected $security;
        /**
         * Register the routes.
         *
         * @since 3.6.2
         * @return void
         */
        abstract public function register();
    }
}
