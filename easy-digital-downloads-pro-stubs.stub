        {
        }
        /**
         * Setup objects
         *
         * @since 3.0
         */
        private function include_objects()
        {
        }
        /**
         * Setup functions
         *
         * @since 3.0
         */
        private function include_functions()
        {
        }
        /**
         * Setup administration
         *
         * @since 3.0
         */
        private function include_admin()
        {
        }
        /**
         * Setup front-end specific code
         *
         * @since 3.0
         */
        private function include_frontend()
