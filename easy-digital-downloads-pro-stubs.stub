namespace EDD\Pro\Taxes\Services {
    /**
     * Service.
     */
    abstract class Service
    {
        /**
         * Result.
         *
         * @var Result
         */
        protected $result;
        /**
         * VAT number.
         *
         * @var string
         */
        protected $vat_number;
        /**
         * The country code.
         *
         * @var string
         */
        protected $country_code;
        /**
         * Constructor.
         *
         * @since 3.5.0
         * @param Result $result The result.
         */
        public function __construct(\EDD\Pro\Taxes\VAT\Result $result)
        {
        }
        /**
         * Gets the result.
         *
         * @since 3.5.0
         * @return Result
         */
        public function get_result(): \EDD\Pro\Taxes\VAT\Result
        {
        }
        /**
         * Sanitizes the VAT number.
         *
         * @since 3.5.0
         * @param string $vat_number The VAT number.
         * @return string
         */
        public function sanitize_vat_number(string $vat_number): string
        {
        }
        /**
         * Checks if the service is available.
         *
         * @since 3.5.0
         * @return bool
         */
        abstract public function requirements_met(): bool;
        /**
         * Handles the request and returns the result.
         *
         * @since 3.5.0
         * @return void
         */
        abstract protected function validate(): void;
        /**
         * Gets the endpoint.
         *
         * @since 3.5.0
         * @return string
         */
        abstract protected function get_endpoint(): string;
    }
