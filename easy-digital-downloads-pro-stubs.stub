        {
        }
        /**
         * Log email_converted event for the specific email that led to conversion.
         *
         * @since 3.6.5
         * @param int      $cart_id  Cart ID.
         * @param int|null $email_id Email ID that led to conversion, or null.
         * @return void
         */
        private function log_email_conversion(int $cart_id, ?int $email_id): void
        {
        }
        /**
         * Deletes the cart for the current session if it exists.
         *
         * Used when a purchase is completed and the cart was never abandoned.
         *
         * @since 3.6.5
         * @return void
         */
        private function maybe_delete_cart(): void
        {
        }
        /**
         * Checks if the current cart was abandoned before completion.
         *
         * @since 3.6.5
         * @return bool True if cart was abandoned, false otherwise.
         */
        private function was_cart_abandoned(): bool
        {
        }
        /**
         * Finds any active (non-terminal) cart associated with an order's customer.
         *
         * Unlike the previous find_abandoned_cart_for_order(), this also matches
         * 'tracking' carts that haven't yet been marked abandoned by the detection cron.
         * This prevents orphaned carts from previous sessions triggering recovery emails.
         *
         * @since 3.6.7
         *
         * @param int $order_id Order ID.
         * @return object|null Cart object if an active cart is found, null otherwise.
         */
        private function find_active_cart_for_order(int $order_id)
        {
        }
        /**
         * Cleans up an orphaned cart found via DB fallback after purchase completion.
         *
         * Abandoned carts are marked as recovered (with order linkage) to preserve analytics.
         * Tracking carts are deleted since they were never abandoned.
         *
         * @since 3.6.7
         *
         * @param object $cart     Cart object from DB.
         * @param int    $order_id Completed order ID.
