         */
        public $roles;
        /**
         * @const FILE
         */
        const FILE = \EDD_SL_PLUGIN_FILE;
        /**
         * @var EDD\SoftwareLicensing\Emails\Notices
         * @since 3.8.12
         */
        public $notices;
        /**
         * Main EDD_Software_Licensing Instance
